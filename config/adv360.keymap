#include <dt-bindings/zmk/stp.h>
#include <behaviors.dtsi>
#include <dt-bindings/zmk/backlight.h>
#include <dt-bindings/zmk/bt.h>
#include <dt-bindings/zmk/keys.h>
#include <dt-bindings/zmk/rgb.h>

/ {
    behaviors {
        #include "macros.dtsi"
      #include "version.dtsi"

        hm: homerow_mods {
            compatible = "zmk,behavior-hold-tap";
            label = "HOMEROW_MODS";
            #binding-cells = <2>;
            tapping-term-ms = <200>;
            quick_tap_ms = <175>;
            flavor = "tap-preferred";
            bindings = <&kp>, <&kp>;
        };

        HML: HML {
            compatible = "zmk,behavior-hold-tap";
            label = "HML";
            bindings = <&kp>, <&kp>;

            #binding-cells = <2>;
            tapping-term-ms = <200>;
            flavor = "balanced";
            quick-tap-ms = <175>;
            hold-trigger-key-positions = <0 1 2 3 4 5 6 14 15 16 17 18 19 20 28 29 30 31 32 33 34 35 36 46 47 48 49 50 51 52 60 61 62 63 64 65 66 67>;
        };

        new_behavior: new_behavior {
            compatible = "zmk,behavior-hold-tap";
            label = "NEW_BEHAVIOR";
            bindings = <&kp>, <&kp>;

            #binding-cells = <2>;
            tapping-term-ms = <280>;
            flavor = "balanced";
            quick-tap-ms = <175>;
            hold-trigger-key-positions = <0 1 14 15 16 17 18 19 20 28 29 30 31 32 33 34 35 36 46 47 48 49 50 51 52 60 61 62 63 64 65 66 67 2 3 4 5 6>;
        };

        layer2: layer2 {
            compatible = "zmk,behavior-toggle-layer";
            label = "LAYER2";
            #binding-cells = <1>;
            toggle-mode = "flip";
        };

        HMR: HMR {
            compatible = "zmk,behavior-hold-tap";
            label = "HMR";
            bindings = <&kp>, <&kp>;

            #binding-cells = <2>;
            tapping-term-ms = <200>;
            flavor = "balanced";
            hold-trigger-key-positions = <12 13 21 22 23 24 25 26 27 37 38 39 40 41 42 43 44 45 53 54 55 56 57 58 59 68 69 70 71 72 73 74 75 7 8 9 10 11 12 13>;
        };

        layerswitch: layerswitch {
            compatible = "zmk,behavior-hold-tap";
            label = "LAYERSWITCH";
            bindings = <&mo>, <&kp>;

            #binding-cells = <2>;
            hold-trigger-key-positions = <65 70 32>;
            tapping-term-ms = <300>;
            flavor = "balanced";
        };

        thumb2: thumb2 {
            compatible = "zmk,behavior-hold-tap";
            label = "THUMB2";
            bindings = <&kp>, <&kp>;

            #binding-cells = <2>;
            tapping-term-ms = <500>;
            hold-trigger-key-positions = <66>;
            flavor = "tap-preferred";
        };

        snip: snip {
            compatible = "zmk,behavior-tap-dance";
            label = "SNIP";
            #binding-cells = <0>;
            bindings = <&screenshot>;
        };
    };

    combos {
        compatible = "zmk,combos";

        cp {
            bindings = <&kp LS(MINUS)>;
            key-positions = <33 40>;
        };
    };

    macros {
        sm3: sm3 {
            compatible = "zmk,behavior-macro";
            #binding-cells = <0>;
            bindings = <&kp LC(LA(LS(S)))>;
            label = "SM3";
        };

        rdo: rdo {
            compatible = "zmk,behavior-macro";
            #binding-cells = <0>;
            bindings = <&kp LA(LC(LS(R)))>;
            label = "RDO";
        };

        task_man: task_man {
            compatible = "zmk,behavior-macro";
            #binding-cells = <0>;
            bindings = <&kp LC(LS(ESCAPE))>;
            label = "TASK_MAN";
        };

        screenshot: screenshot {
            compatible = "zmk,behavior-macro";
            #binding-cells = <0>;
            bindings =
                <&macro_press>,
                <&kp LEFT_WIN>,
                <&macro_press>,
                <&kp LEFT_SHIFT>,
                <&macro_tap>,
                <&kp S>,
                <&macro_release>,
                <&kp LEFT_SHIFT>,
                <&macro_release>,
                <&kp LEFT_WIN>;

            label = "SCREENSHOT";
        };
    };

    keymap {
        compatible = "zmk,keymap";

        default_layer {
            display-name = "Base";
            bindings = <
&kp EQUAL   &kp N1     &kp N2    &kp N3    &kp N4            &kp N5  &tog 1                                                                           &mo 3          &kp N6  &kp N7  &kp N8     &kp N9    &kp N0    &kp MINUS
&kp ESCAPE  &kp Q      &kp W     &kp E     &kp R             &kp T   &kp CAPS                                                                         &snip          &kp Y   &kp U   &kp I      &kp O     &kp P     &kp BSLH
&kp TAB     &kp A      &kp S     &kp D     &layerswitch 3 F  &kp G   &kp TAB               &kp LCTRL   &kp LALT              &kp RALT      &kp HOME   &kp DELETE     &kp H   &kp J   &kp K      &kp L     &kp SEMI  &kp SQT
&kp LSHFT   &kp Z      &kp X     &kp C     &kp V             &kp B                                     &kp PERIOD            &tog 1                                  &kp N   &kp M   &kp COMMA  &kp DOT   &kp FSLH  &kp RSHFT
&mo 2       &kp GRAVE  &kp CAPS  &kp LEFT  &kp RIGHT                 &layerswitch 2 SPACE  &kp ESCAPE  &kp LEFT_CONTROL      &kp LEFT_WIN  &kp ENTER  &kp BACKSPACE          &kp UP  &kp DOWN   &kp LBKT  &kp RBKT  &kp DELETE
            >;
        };

        keypad {
            display-name = "Kp";
            bindings = <
&kp EQUAL  &kp N1     &kp N2    &kp N3    &kp N4     &kp N5  &trans                                              &mo 3   &kp N6     &kp KP_NUM  &kp KP_EQUAL  &kp KP_DIVIDE  &kp KP_MULTIPLY  &kp MINUS
&trans     &kp Q      &kp W     &kp E     &kp R      &kp T   &none                                               &none   &kp Y      &kp KP_N7   &kp KP_N8     &kp KP_N9      &kp KP_MINUS     &kp BSLH
&trans     &kp A      &kp S     &kp D     &kp F      &kp G   &none   &kp LCTRL  &kp LALT      &kp LGUI  &kp TAB  &none   &kp KP_N0  &kp KP_N4   &kp KP_N5     &kp KP_N6      &kp KP_PLUS      &kp SQT
&kp LSHFT  &kp Z      &kp X     &kp C     &kp V      &kp B                      &trans        &trans                     &kp N      &kp KP_N1   &kp KP_N2     &kp KP_N3      &kp KP_ENTER     &kp RSHFT
&mo 2      &kp GRAVE  &kp CAPS  &kp LEFT  &kp RIGHT          &trans  &trans     &trans        &trans    &trans   &trans             &kp UP      &kp DOWN      &kp KP_DOT     &kp RBKT         &trans
            >;
        };

        fn {
            display-name = "Fn";
            bindings = <
&kp F1     &kp F2        &kp F3  &kp F4            &kp F5             &kp F6     &tog 1                                      &kp C_MUTE       &kp F7      &kp F8          &kp F9           &kp F10  &kp F11  &kp F12
&task_man  &kp LEFT_WIN  &trans  &trans            &kp QUESTION       &kp TILDE  &sm3                                        &kp C_VOLUME_UP  &kp SLASH   &kp BACKSLASH   &sm3             &rdo     &trans   &trans
&trans     &trans        &trans  &kp LEFT_BRACKET  &kp RIGHT_BRACKET  &kp GRAVE  &rdo    &trans  &trans      &trans  &trans  &kp C_VOL_DN     &kp PERIOD  &kp LEFT_BRACE  &kp RIGHT_BRACE  &trans   &trans   &trans
&trans     &trans        &trans  &trans            &trans             &trans                     &trans      &trans                           &trans      &trans          &trans           &trans   &trans   &trans
&trans     &trans        &trans  &trans            &trans                        &trans  &trans  &trans      &trans  &trans  &trans                       &trans          &trans           &trans   &trans   &trans
            >;
        };

        mod {
            display-name = "Mod";
            bindings = <
&none           &bt BT_SEL 0  &bt BT_SEL 1  &bt BT_SEL 2  &bt BT_SEL 3  &bt BT_SEL 4  &none                                                                      &trans           &none           &none           &none         &none      &none  &none
&none           &none         &none         &none         &none         &none         &bootloader                                                                &bootloader      &screenshot     &kp HOME        &none         &kp END    &none  &none
&studio_unlock  &none         &none         &none         &none         &none         &none        &none           &none                 &bt BT_CLR  &none       &stp STP_BAT     &kp LEFT_ARROW  &kp DOWN_ARROW  &kp UP_ARROW  &kp RIGHT  &none  &none
&none           &none         &none         &none         &macro_ver    &none                                      &none                 &none                                    &none           &none           &none         &none      &none  &none
&none           &none         &none         &none         &none                       &none        &kp LEFT_SHIFT  &kp LEFT_CONTROL      &none       &bl BL_TOG  &rgb_ug RGB_TOG                  &bl BL_INC      &bl BL_DEC    &none      &none  &none
            >;
        };

        extra1 {
            display-name = "Red";
            status = "reserved";
        };

        layer_5 {
            display-name = "Base";
            bindings = <
&kp EQUAL   &kp N1     &kp N2    &kp N3    &kp N4            &kp N5  &tog 1                                                                               &mo 3          &kp N6  &kp N7  &kp N8     &kp N9    &kp N0    &kp MINUS
&kp ESCAPE  &kp Q      &kp W     &kp E     &kp R             &kp T   &kp CAPS                                                                             &snip          &kp Y   &kp U   &kp I      &kp O     &kp P     &kp BSLH
&kp TAB     &kp A      &kp S     &kp D     &layerswitch 3 F  &kp G   &kp TAB               &kp LCTRL   &kp LALT              &kp RALT          &kp HOME   &kp DELETE     &kp H   &kp J   &kp K      &kp L     &kp SEMI  &kp SQT
&kp LSHFT   &kp Z      &kp X     &kp C     &kp V             &kp B                                     &kp PERIOD            &tog 1                                      &kp N   &kp M   &kp COMMA  &kp DOT   &kp FSLH  &kp RSHFT
&mo 2       &kp GRAVE  &kp CAPS  &kp LEFT  &kp RIGHT                 &layerswitch 2 SPACE  &kp ESCAPE  &kp LEFT_COMMAND      &kp LEFT_CONTROL  &kp ENTER  &kp BACKSPACE          &kp UP  &kp DOWN   &kp LBKT  &kp RBKT  &kp DELETE
            >;
        };
    };
};
